{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "arrowParens": "avoid",
  "tabWidth": 2,
  "singleQuote": true,
  "printWidth": 100,
  "trailingComma": "all",
  "sortImports": true,
  "sortPackageJson": false,
  "sortTailwindcss": { "stylesheet": "./src/routes/app.css" },
  "svelte": { "allowShorthand": true }
}
