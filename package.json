{
  "name": "sveltekit",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "prepare": "svelte-kit sync",
    "preview": "vite preview",
    "fmt": "prettier . --experimental-cli --cache-location .prettiercache --check",
    "fmt:fix": "prettier . --experimental-cli --cache-location .prettiercache --write",
    "lint": "pnpm run --workspace-root --parallel /lint:/",
    "lint:eslint": "eslint --cache --concurrency auto",
    "lint:svelte": "svelte-check --fail-on-warnings"
  },
  "dependencies": {
    "@sveltejs/kit": "^2.70.2",
    "svelte": "^5.56.8"
  },
  "devDependencies": {
