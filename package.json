{
  "name": "sveltekit",
  "type": "module",
  "private": true,
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.5.1",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "prepare": "svelte-kit sync",
    "preview": "vite preview",
    "fmt": "oxfmt --check .",
    "fmt:fix": "oxfmt .",
    "lint:eslint": "eslint --cache --concurrency auto",
    "lint:svelte": "svelte-check --fail-on-warnings"
  },
  "dependencies": {
    "@sveltejs/kit": "^2.70.3",
    "svelte": "^5.57.0"
  },
  "devDependencies": {
    "@eslint/css": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@html-eslint/eslint-plugin": "^0.66.1",
    "@html-eslint/eslint-plugin-svelte": "^0.66.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^16.5.0",
    "oxfmt": "^0.68.0",
    "svelte-check": "^4.7.6",
    "tailwind-csstree": "^0.4.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0"
  }
}
